# Microsoft Foundry project (Overview page -> project endpoint). Auth via `az login` / managed identity.
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL_DEPLOYMENT=chat-model

# Token prices (USD per 1M tokens) for cost tracking — copy from the Azure price sheet for your model.
PRICE_INPUT_PER_M=0.40
PRICE_OUTPUT_PER_M=1.60

# Release-gate thresholds
EVAL_MAX_LATENCY_MS=15000
EVAL_MAX_COST_USD=0.02

# Optional: pin prompt versions (default = latest)
# PROMPT_VERSION_TRIAGE=v1

# Optional tracing: Azure Monitor (also shows in Foundry tracing) or any OTLP collector
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
